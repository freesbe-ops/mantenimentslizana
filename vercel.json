{
  "redirects": [
    { "source": "/index.html", "destination": "/ca", "permanent": true },
    { "source": "/404.html", "destination": "/ca", "permanent": true },
    { "source": "/", "destination": "/ca", "permanent": true },

    { "source": "/:lang/index.html", "destination": "/:lang", "permanent": true },
    { "source": "/:lang/serveis/:service/index.html", "destination": "/:lang/serveis/:service", "permanent": true },
    { "source": "/:path*/index.html", "destination": "/:path*", "permanent": true },
    { "source": "/:path*.html", "destination": "/:path*", "permanent": true },

    { "source": "/:lang/serveis/jardins", "destination": "/:lang/serveis/jardineria", "permanent": true },

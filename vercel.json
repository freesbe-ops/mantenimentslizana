    { "source": "/:lang/serveis/manteniment-general", "destination": "/:lang/serveis/manteniment", "permanent": true },
    { "source": "/:lang/serveis/manteniment-general/", "destination": "/:lang/serveis/manteniment", "permanent": true },

    { "source": "/ca/jardineria", "destination": "/ca/serveis/jardineria", "permanent": true },
    { "source": "/ca/jardineria/", "destination": "/ca/serveis/jardineria", "permanent": true },
    { "source": "/es/jardineria", "destination": "/es/serveis/jardineria", "permanent": true },
    { "source": "/es/jardineria/", "destination": "/es/serveis/jardineria", "permanent": true },
    { "source": "/ca/piscines", "destination": "/ca/serveis/piscines", "permanent": true },
    { "source": "/ca/piscines/", "destination": "/ca/serveis/piscines", "permanent": true },
    { "source": "/es/piscinas", "destination": "/es/serveis/piscines", "permanent": true },
    { "source": "/es/piscinas/", "destination": "/es/serveis/piscines", "permanent": true },

    { "source": "/ca/politica-privacitat", "destination": "/ca/politica-de-privacitat", "permanent": true },
    { "source": "/ca/politica-privacitat/", "destination": "/ca/politica-de-privacitat", "permanent": true },
    { "source": "/es/politica-privacidad", "destination": "/es/politica-de-privacidad", "permanent": true },
    { "source": "/es/politica-privacidad/", "destination": "/es/politica-de-privacidad", "permanent": true },
    { "source": "/ca/rgpd", "destination": "/ca/politica-de-privacitat", "permanent": true },
    { "source": "/ca/rgpd/", "destination": "/ca/politica-de-privacitat", "permanent": true },
    { "source": "/es/rgpd", "destination": "/es/politica-de-privacidad", "permanent": true },
    { "source": "/es/rgpd/", "destination": "/es/politica-de-privacidad", "permanent": true },

    { "source": "/ca/condicions-us", "destination": "/ca", "permanent": true },
    { "source": "/ca/condicions-us/", "destination": "/ca", "permanent": true },
    { "source": "/es/condiciones-uso", "destination": "/es", "permanent": true },
    { "source": "/es/condiciones-uso/", "destination": "/es", "permanent": true },
    { "source": "/ca/contacte", "destination": "/ca", "permanent": true },
    { "source": "/ca/contacte/", "destination": "/ca", "permanent": true },
    { "source": "/es/contacto", "destination": "/es", "permanent": true },
    { "source": "/es/contacto/", "destination": "/es", "permanent": true }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
